# Figures are regenerated by running the notebooks; shipping them would make the repository
# look reproduced when it had only been downloaded.
figures/*.pdf
figures/*.png
figures/other_renders/
figures/source_data/
figures/RENDER_LOG.tsv
figures/FIGURE_PANELS.tsv
__pycache__/
.ipynb_checkpoints/
# Panels that the paper's scripts write beside their run directory. render_all.py collects
# them into figures/; shipping both copies would make the repository look reproduced.
data/runs/**/panels/


# NanoMethViz writes an RData alongside each region plot; it is 4 MB of plot object
# that nothing in this repository reads.
figures/**/*.RData

# make_icr_panel.py writes its table one level above the output directory it is given,
# which for a notebook run is figures/. render_all.py moves the batch copy into
# figures/all/source_data; this is the one a single notebook leaves behind.
figures/source_data/
