#!/bin/bash
## NanoMethViz 3.2.0, the version the paper's figures were drawn with. The newest conda
## build of it is 2.8.1, against R 4.3, and 2.8.1's plot_grange() does not take
## smoothing_window, heatmap_subsample or gene_anno. So it is built from Bioconductor
## here. Its dependencies are already in the image from environment.yml, so this compiles
## one package rather than a chain of them.
##
## It must not fail the image. If it does not succeed the GNAS notebook says so in its
## first cell and falls back to the figure the paper's own run produced.
set -u

## Which compiler. NanoMethViz declares C++20, so R builds it with CXX20 and nothing
## else: a Makevars that sets CC and CXX is read and then ignored, which looks exactly
## like an override that did not take. conda's R leaves CXX20 empty unless a conda
## compiler package is installed, and installing one is not the answer either -
## conda-forge's cxx-compiler was tried and its driver could not reach its own cc1plus.
##
## So ask R for CXX20 directly. "Can this environment compile anything" is the wrong
## question and answers yes while the C++20 build still fails with
## "C++20 standard requested but CXX20 is not defined".
probe=$(mktemp -d)
printf '#include <version>\n#include <string>\nconsteval int f(){return 1;}\nint main(){return f()-1;}\n' \
  > "$probe/t.cpp"
cxx20=$(R CMD config CXX20 2>/dev/null)
std=$(R CMD config CXX20STD 2>/dev/null); std=${std:--std=gnu++20}
ok=no
if [ -n "$cxx20" ] && $cxx20 $std -c "$probe/t.cpp" -o "$probe/t.o" >/dev/null 2>&1; then
  ok=yes
fi

if [ "$ok" = yes ]; then
  echo "postBuild: building with R's CXX20, $cxx20"
elif command -v g++ >/dev/null 2>&1 && g++ -std=gnu++20 -c "$probe/t.cpp" -o "$probe/t.o" >/dev/null 2>&1; then
  ## The whole CXX<n> family, not just the compiler. When conda's Makeconf has no
  ## CXX20 it has no CXX20STD, CXX20FLAGS or CXX20PICFLAGS either, and each missing one
  ## fails differently and later: no STD builds under the wrong standard, no PICFLAGS
  ## compiles without -fPIC and dies at the link with "relocation R_X86_64_PC32 against
  ## symbol can not be used when making a shared object".
  gxx=$(command -v g++)
  cxxflags=$(R CMD config CXXFLAGS 2>/dev/null); cxxflags=${cxxflags:--O2 -g}
  mkdir -p "$HOME/.R"
  {
    echo "CC  = $(command -v gcc)"
    for n in "" 11 14 17 20; do
      echo "CXX$n = $gxx"
      echo "CXX${n}FLAGS = $cxxflags"
      echo "CXX${n}PICFLAGS = -fPIC"
      [ -n "$n" ] && echo "CXX${n}STD = -std=gnu++$n"
    done
  } > "$HOME/.R/Makevars"
  echo "postBuild: R's CXX20 (${cxx20:-unset}) cannot build C++20; using $(command -v g++)"
else
  echo "postBuild: no working C++20 compiler; NanoMethViz will be skipped"
fi
rm -rf "$probe"

## GenomeInfoDbData first. It is annotation data, not code, and bioconda ships it as a
## post-link script that downloads it at install time rather than as files in the package,
## so a conda environment can hold bioconductor-genomeinfodbdata and still not have it.
## BiocManager does not catch that: GenomeInfoDb is present, so it treats the branch as
## satisfied and never looks at what GenomeInfoDb itself needs. NanoMethViz then compiles
## and fails at the last step with "there is no package called 'GenomeInfoDbData'".
R -q -e 'if (!requireNamespace("GenomeInfoDbData", quietly = TRUE)) {
           if (!requireNamespace("BiocManager", quietly = TRUE))
             install.packages("BiocManager", repos = "https://cloud.r-project.org")
           BiocManager::install("GenomeInfoDbData", ask = FALSE, update = FALSE)
         }' || true

R -q -e 'if (!requireNamespace("NanoMethViz", quietly = TRUE) ||
             packageVersion("NanoMethViz") < "3.0.0") {
           if (!requireNamespace("BiocManager", quietly = TRUE))
             install.packages("BiocManager", repos = "https://cloud.r-project.org")
           BiocManager::install("NanoMethViz", ask = FALSE, update = FALSE)
         }
         ## packageVersion() reads the directory and answers for a package that will not
         ## load; one such check once reported a version on an R too old to run it.
         ## library() is the check.
         cat("NanoMethViz:",
             tryCatch({ suppressMessages(library(NanoMethViz))
                        as.character(packageVersion("NanoMethViz")) },
                      error = function(e) paste("will not load:", conditionMessage(e))),
             "on R", as.character(getRversion()), "\n")' || true
